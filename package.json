{
  "name": "barbearia-retro",
  "version": "0.2.0",
  "private": true,
  "description": "Barbearia Retro v0.2 — monorepo SaaS de barbearia com RBAC e UI retrô.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @barbearia-retro/api db:migrate",
    "db:seed": "pnpm --filter @barbearia-retro/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  }
}
