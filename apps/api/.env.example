# ──────────────────────────────────────────────────────────────
#  BunkerBarbershop API — variáveis de ambiente (exemplo)
#  Copie para .env e ajuste os valores. NUNCA commite .env.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── Banco de dados (Postgres local via docker-compose) ────────
DATABASE_URL=postgresql://bunker:bunker@localhost:5432/bunker

# ── Auth (Better-Auth + JWT próprio) ─────────────────────────
# Mínimo 32 caracteres. Use `openssl rand -base64 32` para gerar.
JWT_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-chars
BETTER_AUTH_URL=http://localhost:3001

# ── CORS ──────────────────────────────────────────────────────
# Origens permitidas separadas por vírgula. Vite usa 5173.
CORS_ORIGINS=http://localhost:5173
